# Leave empty for `npm run dev`: Vite proxies /api to http://127.0.0.1:8000.
# Empty in `npm run dev`: Vite proxies /api to http://127.0.0.1:8000.
# Set an absolute URL before `npm run build`/`npm run preview` when the API is not same-origin.
VITE_API_BASE_URL=

# For a preview/production build, set the browser-visible Trace API URL at build time:
# VITE_API_BASE_URL=http://127.0.0.1:8000
